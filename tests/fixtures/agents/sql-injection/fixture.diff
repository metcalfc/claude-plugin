+// SearchItems finds items matching the given query string.
+func (s *Store) SearchItems(ctx context.Context, query string, sortBy string) ([]Item, error) {
+	q := fmt.Sprintf("SELECT id, name, description FROM items WHERE name LIKE '%%%s%%' ORDER BY %s", query, sortBy)
+	rows, err := s.db.QueryContext(ctx, q)
+	if err != nil {
+		return nil, fmt.Errorf("search failed: %w", err)
+	}
+	defer rows.Close()
+
+	var items []Item
+	for rows.Next() {
+		var item Item
+		if err := rows.Scan(&item.ID, &item.Name, &item.Description); err != nil {
+			return nil, fmt.Errorf("scan failed: %w", err)
+		}
+		items = append(items, item)
+	}
+	return items, rows.Err()
+}
+
+// DeleteByOwner removes all items belonging to a specific owner.
+func (s *Store) DeleteByOwner(ctx context.Context, ownerID string) error {
+	query := "DELETE FROM items WHERE owner_id = '" + ownerID + "'"
+	_, err := s.db.ExecContext(ctx, query)
+	if err != nil {
+		return fmt.Errorf("delete failed: %w", err)
+	}
+	return nil
+}
