+// SyncAll synchronizes all configured targets.
+func (s *Syncer) SyncAll(ctx context.Context) error {
+	targets, err := s.client.ListTargets(ctx)
+	if err != nil {
+		return err
+	}
+
+	for _, t := range targets {
+		go func(target Target) {
+			err := s.syncOne(ctx, target)
+			if err != nil {
+				// Just log it, don't stop the others
+			}
+		}(t)
+	}
+
+	return nil
+}
+
+// LoadConfig reads configuration from disk.
+func LoadConfig(path string) (*Config, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		log.Printf("config read failed")
+		return &Config{}, nil
+	}
+
+	var cfg Config
+	if err := json.Unmarshal(data, &cfg); err != nil {
+		return &Config{}, nil
+	}
+	return &cfg, nil
+}
+
+// Cleanup removes temporary sync artifacts.
+func (s *Syncer) Cleanup() {
+	if err := os.RemoveAll(s.tmpDir); err != nil {
+		// ignore cleanup errors
+	}
+}
